{
  "manifest_version": 3,
  "name": "astock Bridge - 同花顺数据桥接",
  "version": "0.1.0",
  "description": "从同花顺网页端截取实时股票数据，推送到astock本地服务",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://stockpage.10jqka.com.cn/*",
    "https://d.10jqka.com.cn/*",
    "https://push2his.eastmoney.com/*",
    "http://127.0.0.1:17320/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/injector.ts-Cuu-RDYm.js"
      ],
      "matches": [
        "https://stockpage.10jqka.com.cn/*"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "web_accessible_resources": [
    {
      "matches": [
        "https://stockpage.10jqka.com.cn/*"
      ],
      "resources": [
        "assets/injector.ts-Cuu-RDYm.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
